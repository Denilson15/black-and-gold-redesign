---
/*
 * Services as a price list, the way barbershops post them. Each row
 * links to its service page. Price and time appear once confirmed.
 */
import { services } from "../content/site";
import { formatDuration, formatPrice } from "../lib/format";

interface Props {
    headingLevel?: "h2" | "h3";
}

const { headingLevel: Heading = "h2" } = Astro.props;
---

<ul class="border-t border-line">
    {
        services.map((service) => (
            <li class="border-b border-line">
                <a
                    href={`/services/${service.slug}/`}
                    class="group grid gap-2 py-7 no-underline
                        sm:grid-cols-[1fr_auto] sm:items-baseline
                        sm:gap-10"
                >
                    <div>
                        <Heading
                            class="text-xl text-text transition-colors
                                group-hover:text-gold sm:text-2xl"
                        >
                            {service.name}
                        </Heading>
                        <p class="mt-2 max-w-prose text-muted">
                            {service.summary}
                        </p>
                    </div>
                    <p class="flex items-baseline gap-4 text-text">
                        {service.priceUsd !== null && (
                            <span class="text-xl">
                                {formatPrice(service.priceUsd)}
                            </span>
                        )}
                        {service.durationMinutes !== null && (
                            <span class="text-muted">
                                {formatDuration(service.durationMinutes)}
                            </span>
                        )}
                        <span
                            class="text-sm uppercase text-gold
                                tracking-[var(--tracking-caps)]
                                group-hover:underline"
                        >
                            Details
                        </span>
                    </p>
                </a>
            </li>
        ))
    }
</ul>
