---
/*
 * "Message on Instagram" for a shop or barber handle.
 * - Primary link opens a DM via ig.me (the Instagram app on phones).
 * - A small fallback link opens the public profile.
 * - Renders nothing for missing or unconfirmed handles, so we never
 *   link to a stranger's account.
 */
import type { InstagramHandle } from "../content/site";
import Button from "./Button.astro";

interface Props {
    instagram: InstagramHandle | null;
    /** Whose inbox, for screen readers: "Mel", "Black & Gold East Bay". */
    who: string;
    /** Colors for black (default) or white/gold backgrounds. */
    tone?: "dark" | "light";
    class?: string;
}

const {
    instagram,
    who,
    tone = "dark",
    class: extraClass = "",
} = Astro.props;
const show = instagram !== null && instagram.confirmed;
---

{
    show && (
        <div class:list={["flex flex-col gap-1", extraClass]}>
            <Button
                href={`https://ig.me/m/${instagram.handle}`}
                variant={tone === "dark" ? "secondary" : "outline-dark"}
                external
            >
                <span>
                    Message <span class="sr-only">{who}</span> on Instagram
                </span>
            </Button>
            <a
                href={`https://www.instagram.com/${instagram.handle}/`}
                class="self-start py-1 text-sm underline hover:no-underline"
                rel="noopener"
                target="_blank"
            >
                @{instagram.handle}
                <span class="sr-only">on Instagram (opens in a new tab)</span>
            </a>
        </div>
    )
}
