---
/* Gold footer, like the shop's current site, with NAP and hours. */
import { Image } from "astro:assets";
import Address from "./Address.astro";
import HoursList from "./HoursList.astro";
import InstagramDM from "./InstagramDM.astro";
import logoMark from "../assets/shop/logo-mark.webp";
import { business } from "../content/site";
import { navLinks } from "../lib/nav";
import { mapsDirectionsUrl } from "../lib/maps";

const year = new Date().getFullYear();
---

<footer class="on-light bg-gold text-text-dark">
    <div
        class="mx-auto grid max-w-page gap-10 px-gutter py-14
            sm:grid-cols-2 lg:grid-cols-4"
    >
        <div>
            <Image
                src={logoMark}
                alt=""
                width={64}
                height={64}
                densities={[2, 3]}
                class="size-16 rounded-full bg-ink"
            />
            <p
                class="mt-4 text-sm uppercase
                    tracking-[var(--tracking-caps-wide)]"
            >
                Barbershop in Hayward, CA
            </p>
        </div>

        <div>
            <h2 class="heading-sm">
                Visit
            </h2>
            <div class="mt-3">
                <Address />
            </div>
            <a
                href={mapsDirectionsUrl}
                class="mt-1 inline-block py-1 underline hover:no-underline"
                rel="noopener"
                target="_blank"
            >
                Get directions
                <span class="sr-only">(opens Google Maps in a new tab)</span>
            </a>
        </div>

        <HoursList headingLevel="h2" tone="light" />

        <div>
            <h2 class="heading-sm">
                Follow
            </h2>
            <InstagramDM
                instagram={business.instagram}
                who={business.name}
                tone="light"
                class="mt-3"
            />
        </div>
    </div>

    <div class="border-t border-text-dark/15">
        <div
            class="mx-auto flex max-w-page flex-col gap-3 px-gutter py-6
                text-sm sm:flex-row sm:items-center sm:justify-between"
        >
            <nav aria-label="Footer">
                <ul class="flex flex-wrap gap-x-6 gap-y-1">
                    {
                        navLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class="inline-block py-2
                                        hover:underline"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                    <li>
                        <a href="/privacy/" class="inline-block py-2
                            hover:underline">
                            Privacy
                        </a>
                    </li>
                </ul>
            </nav>
            <p>© {year} {business.name}</p>
        </div>
    </div>
</footer>
