---
/*
 * One barber: photo, name, specialty, bio, and two actions.
 * Booking is the dominant action; Instagram is for questions and only
 * appears for a confirmed handle.
 */
import Button from "./Button.astro";
import InstagramDM from "./InstagramDM.astro";
import { barberBookingUrl, type Barber } from "../content/site";
import { firstName, initial } from "../lib/format";

interface Props {
    barber: Barber;
    headingLevel?: "h2" | "h3";
}

const { barber, headingLevel: Heading = "h2" } = Astro.props;
const first = firstName(barber.name);
---

<!-- Phones: photo beside text. Tablet up: photo on top. -->
<article
    class="grid w-full grid-cols-[6.5rem_minmax(0,1fr)] overflow-hidden
        rounded-panel border border-line bg-surface sm:flex sm:flex-col"
>
    {
        barber.photo ? (
            <img
                src={barber.photo}
                alt={`${barber.name}, barber at Black & Gold East Bay`}
                width="600"
                height="750"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover sm:aspect-[4/5]
                    sm:h-auto"
            />
        ) : (
            // Empty state until the barber approves a photo.
            <div
                class="flex h-full w-full items-center justify-center
                    bg-ink sm:aspect-[4/5] sm:h-auto"
                role="img"
                aria-label={`Photo of ${barber.name} coming soon`}
            >
                <span
                    class="gilded font-display text-6xl font-extrabold
                        leading-none sm:text-[7rem]"
                    aria-hidden="true"
                >
                    {initial(barber.name)}
                </span>
            </div>
        )
    }

    <div class="flex flex-1 flex-col gap-3 p-4 sm:gap-4 sm:p-5">
        <div>
            <Heading class="text-3xl text-text">{barber.name}</Heading>
            {
                barber.specialty && (
                    <p class="mt-1 text-gold">{barber.specialty}</p>
                )
            }
        </div>

        {
            barber.bio ? (
                <p class="text-muted">{barber.bio}</p>
            ) : (
                <p>
                    <span class="tbd">Bio and specialty coming soon</span>
                </p>
            )
        }

        <div class="mt-auto flex flex-col gap-3 pt-2">
            <Button
                href={barberBookingUrl(barber)}
                ariaLabel={`Book with ${barber.name}`}
            >
                Book with {first}
            </Button>
            <InstagramDM instagram={barber.instagram} who={barber.name} />
        </div>
    </div>
</article>
