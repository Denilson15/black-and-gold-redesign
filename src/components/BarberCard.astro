---
/*
 * One barber, for white sections: portrait, name, optional specialty
 * and bio, and two actions. Booking is the dominant action; Instagram
 * only appears for a confirmed handle.
 */
import { Image } from "astro:assets";
import Button from "./Button.astro";
import InstagramDM from "./InstagramDM.astro";
import { barberBookingUrl, type Barber } from "../content/site";
import { firstName, initial } from "../lib/format";

interface Props {
    barber: Barber;
    headingLevel?: "h2" | "h3";
}

const { barber, headingLevel: Heading = "h2" } = Astro.props;
const first = firstName(barber.name);
---

<article class="flex w-full flex-col text-text-dark">
    {
        barber.photo ? (
            <Image
                src={barber.photo}
                alt={`${barber.name}, barber at Black & Gold East Bay`}
                widths={[320, 480, 720]}
                sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw,
                    48vw"
                class="aspect-[4/5] w-full object-cover object-top"
            />
        ) : (
            <div
                class="flex aspect-[4/5] w-full items-center justify-center
                    bg-line-paper"
                role="img"
                aria-label={`Photo of ${barber.name} coming soon`}
            >
                <span class="text-6xl font-medium" aria-hidden="true">
                    {initial(barber.name)}
                </span>
            </div>
        )
    }

    <div class="flex flex-1 flex-col gap-3 pt-4">
        <div>
            <Heading class="text-sm sm:text-base">
                {barber.name}
            </Heading>
            {
                barber.specialty && (
                    <p class="mt-1 text-sm text-muted-dark">
                        {barber.specialty}
                    </p>
                )
            }
        </div>
        {barber.bio && <p class="text-muted-dark">{barber.bio}</p>}

        <div class="mt-auto flex flex-col gap-2 pt-1">
            <Button
                href={barberBookingUrl(barber)}
                variant="dark"
                ariaLabel={`Book with ${barber.name}`}
                class="w-full px-2 text-xs tracking-[0.08em] sm:text-sm"
            >
                Book with {first}
            </Button>
            <InstagramDM
                instagram={barber.instagram}
                who={barber.name}
                tone="light"
            />
        </div>
    </div>
</article>
