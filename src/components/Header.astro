---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
import { booking } from "../content/site";
import { navLinks } from "../lib/nav";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<header class="sticky top-0 z-30 border-b border-line bg-ink/95
    backdrop-blur">
    <div
        class="mx-auto flex max-w-page items-center justify-between gap-4
            px-gutter py-3"
    >
        <Logo />

        <nav aria-label="Main" class="hidden lg:block">
            <ul class="flex items-center gap-7">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                aria-current={
                                    isCurrent(link.href) ? "page" : undefined
                                }
                                class="py-2 text-sm uppercase
                                    tracking-[var(--tracking-caps)]
                                    text-text no-underline hover:text-gold
                                    aria-[current=page]:text-gold"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex items-center gap-2">
            <!-- Phones use the sticky bottom bar instead. -->
            <div class="hidden md:block">
                <Button href={booking.url}>Book now</Button>
            </div>

            <!-- Mobile menu: a native disclosure, works without JS. -->
            <details class="group relative lg:hidden">
                <summary
                    class="flex min-h-12 cursor-pointer list-none
                        items-center px-3 text-sm uppercase
                        tracking-[var(--tracking-caps)] text-text
                        [&::-webkit-details-marker]:hidden"
                >
                    <span class="group-open:hidden">Menu</span>
                    <span class="hidden group-open:inline">Close</span>
                </summary>
                <nav
                    aria-label="Main"
                    class="absolute right-0 z-30 mt-2 w-60 border
                        border-line bg-charcoal p-2"
                >
                    <ul>
                        {
                            navLinks.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        aria-current={
                                            isCurrent(link.href)
                                                ? "page"
                                                : undefined
                                        }
                                        class="block px-3 py-3 text-sm
                                            uppercase
                                            tracking-[var(--tracking-caps)]
                                            text-text no-underline
                                            hover:text-gold
                                            aria-[current=page]:text-gold"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>
            </details>
        </div>
    </div>
</header>
