---
/*
 * Shop hours. Until the owner confirms them, visitors see a plain
 * "open times are on the booking calendar" note instead of guesses.
 */
import { business, hours } from "../content/site";
import { formatHoursRow } from "../lib/format";

interface Props {
    /** Heading level for the "Hours" label, to keep outlines logical. */
    headingLevel?: "h2" | "h3";
    /** Colors for black (default) or white/gold backgrounds. */
    tone?: "dark" | "light";
    class?: string;
}

const {
    headingLevel: Heading = "h3",
    tone = "dark",
    class: extraClass = "",
} = Astro.props;
const isConfirmed = hours.confirmed && hours.week.length > 0;
const muted = tone === "dark" ? "text-muted" : "text-text-dark/80";
---

<div class={extraClass}>
    <Heading class="heading-sm">
        Hours
    </Heading>
    {
        isConfirmed ? (
            <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1">
                {hours.week.map((row) => (
                    <>
                        <dt class={muted}>{row.day}</dt>
                        <dd>{formatHoursRow(row)}</dd>
                    </>
                ))}
            </dl>
        ) : (
            <p class:list={["mt-3", muted]}>
                Open times are shown on the booking calendar. Questions?
                Call{" "}
                <a
                    href={`tel:${business.phoneE164}`}
                    class="whitespace-nowrap underline hover:no-underline"
                >
                    {business.phoneDisplay}
                </a>
                .
            </p>
        )
    }
</div>
