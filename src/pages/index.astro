---
import BaseLayout from "../layouts/BaseLayout.astro";
import Address from "../components/Address.astro";
import BarberCard from "../components/BarberCard.astro";
import Button from "../components/Button.astro";
import HoursList from "../components/HoursList.astro";
import ServiceList from "../components/ServiceList.astro";
import { barbers, booking, business, reviews } from "../content/site";
import { mapsDirectionsUrl, reviewsUrl } from "../lib/maps";

const approvedReviews = reviews.filter((r) => r.approvedByOwner);
---

<BaseLayout
    title="Barbershop in Hayward, CA | Black & Gold East Bay"
    description="Fades, tapers, beard trims and hot towel shaves at Black &
        Gold East Bay, 846 B St in Downtown Hayward. Book online with
        your barber in seconds."
>
    <!-- Hero: the gilded window. -->
    <section class="mx-auto max-w-page px-gutter pt-10 pb-12 sm:pt-16">
        <h1 class="gilded font-display text-hero font-black">
            Precision cuts in Hayward
        </h1>
        <p class="mt-6 max-w-prose text-xl text-text">
            Fades, tapers, beard work and hot towel shaves on B Street.
            Pick your barber and book online.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
            <Button href={booking.url} size="lg">Book now</Button>
            <Button
                href={`tel:${business.phoneE164}`}
                variant="secondary"
                size="lg"
            >
                Call {business.phoneDisplay}
            </Button>
        </div>
    </section>

    <!-- Visit strip: what someone from Google Maps needs first. -->
    <section
        aria-labelledby="visit-heading"
        class="mx-auto max-w-page px-gutter"
    >
        <h2 id="visit-heading" class="sr-only">Visit the shop</h2>
        <div
            class="grid gap-8 rounded-panel border border-line bg-surface
                p-6 text-muted sm:grid-cols-2 sm:p-8"
        >
            <div>
                <h3 class="text-2xl text-text">Location</h3>
                <div class="mt-3">
                    <Address />
                </div>
                <a
                    href={mapsDirectionsUrl}
                    class="mt-2 inline-block py-1 underline hover:text-gold"
                    rel="noopener"
                    target="_blank"
                >
                    Get directions
                    <span class="sr-only">
                        (opens Google Maps in a new tab)
                    </span>
                </a>
            </div>
            <HoursList />
        </div>
    </section>

    <!-- Services -->
    <section
        aria-labelledby="services-heading"
        class="mx-auto mt-section max-w-page px-gutter"
    >
        <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="services-heading" class="text-4xl text-text">
                Services
            </h2>
            <a href="/services/" class="py-2 text-muted underline
                hover:text-gold">
                All services and prices
            </a>
        </div>
        <div class="mt-6">
            <ServiceList headingLevel="h3" />
        </div>
    </section>

    <!-- Barbers -->
    <section
        aria-labelledby="barbers-heading"
        class="mx-auto mt-section max-w-page px-gutter"
    >
        <h2 id="barbers-heading" class="text-4xl text-text">
            Meet the barbers
        </h2>
        <p class="mt-3 max-w-prose text-lg text-muted">
            {business.experienceLine} Book with the barber you know, or
            try someone new.
        </p>
        <ul
            class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
            role="list"
        >
            {
                barbers.map((barber) => (
                    <li class="flex">
                        <BarberCard barber={barber} headingLevel="h3" />
                    </li>
                ))
            }
        </ul>
    </section>

    <!-- Reviews: real ones only. Empty state links to Google. -->
    <section
        aria-labelledby="reviews-heading"
        class="mx-auto mt-section max-w-page px-gutter"
    >
        <h2 id="reviews-heading" class="text-4xl text-text">
            What clients say
        </h2>
        {
            approvedReviews.length > 0 ? (
                <ul class="mt-6 grid gap-6 md:grid-cols-3" role="list">
                    {approvedReviews.slice(0, 3).map((review) => (
                        <li>
                            <figure class="border-l-2 border-gold pl-5">
                                <blockquote class="text-lg text-text">
                                    “{review.quote}”
                                </blockquote>
                                <figcaption class="mt-3 text-muted">
                                    {review.author}, on {review.source}
                                </figcaption>
                            </figure>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="mt-4 max-w-prose text-lg text-muted">
                    Read what clients say about us on Google, and leave a
                    review after your next visit.
                </p>
            )
        }
        <div class="mt-6">
            <Button href={reviewsUrl} variant="secondary" external>
                Read our Google reviews
            </Button>
        </div>
    </section>
</BaseLayout>
