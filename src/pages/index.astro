---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Address from "../components/Address.astro";
import BarberCard from "../components/BarberCard.astro";
import BookingBand from "../components/BookingBand.astro";
import Button from "../components/Button.astro";
import HoursList from "../components/HoursList.astro";
import ServiceList from "../components/ServiceList.astro";
import logoBadge from "../assets/shop/logo-badge.png";
import {
    barbers,
    booking,
    business,
    hero,
    reviews,
} from "../content/site";
import { mapsDirectionsUrl, reviewsUrl } from "../lib/maps";

const approvedReviews = reviews.filter((r) => r.approvedByOwner);
// Poster frame for the optional hero video.
const poster = hero.videoSrc
    ? (await getImage({ src: hero.image, width: 1280, format: "webp" })).src
    : null;
---

<BaseLayout
    title="Barbershop in Hayward, CA | Black & Gold East Bay"
    description="Fades, tapers, beard trims and hot towel shaves at Black &
        Gold East Bay, 846 B St in Downtown Hayward. Book online with
        your barber in seconds."
>
    <!-- Hero: the shop's own photo (or video), logo badge, booking. -->
    <section class="relative isolate overflow-hidden">
        <Image
            src={hero.image}
            alt={hero.imageAlt}
            widths={[640, 960, 1280, 1600]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 -z-20 h-full w-full object-cover"
        />
        {
            hero.videoSrc && (
                <video
                    class="hero-video absolute inset-0 -z-20 hidden h-full
                        w-full object-cover"
                    src={hero.videoSrc}
                    poster={poster ?? undefined}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                />
            )
        }
        <!-- Darkens the photo so white text keeps strong contrast. -->
        <div
            class="absolute inset-0 -z-10 bg-gradient-to-b from-ink/75
                via-ink/70 to-ink"
            aria-hidden="true"
        >
        </div>

        <div
            class="mx-auto flex min-h-[78svh] max-w-page flex-col
                items-center justify-center px-gutter py-16 text-center"
        >
            <Image
                src={logoBadge}
                alt=""
                width={168}
                height={176}
                densities={[2, 3]}
                loading="eager"
                class="w-28 sm:w-36"
            />
            <h1 class="mt-8 text-hero font-normal text-text">
                Precision cuts in Hayward
            </h1>
            <p class="mt-6 max-w-prose text-lg text-text/85 sm:text-xl">
                Fades, tapers, beard work and hot towel shaves on B Street.
                Pick your barber and book online.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-3">
                <Button href={booking.url} size="lg">Book now</Button>
                <Button
                    href={`tel:${business.phoneE164}`}
                    variant="secondary"
                    size="lg"
                    class="bg-ink/40"
                >
                    Call {business.phoneDisplay}
                </Button>
            </div>
        </div>
    </section>

    <!-- Visit strip: what someone coming from Google Maps needs first. -->
    <section aria-labelledby="visit-heading" class="border-b border-line">
        <h2 id="visit-heading" class="sr-only">Visit the shop</h2>
        <div
            class="mx-auto grid max-w-page gap-10 px-gutter py-12
                text-muted sm:grid-cols-3"
        >
            <div>
                <h3
                    class="heading-sm text-text"
                >
                    Location
                </h3>
                <div class="mt-3">
                    <Address />
                </div>
            </div>
            <HoursList class="[&_h3]:text-text" />
            <div class="flex flex-col items-start gap-3">
                <h3
                    class="heading-sm text-text"
                >
                    Directions
                </h3>
                <p>Downtown Hayward, on B Street.</p>
                <Button href={mapsDirectionsUrl} variant="secondary" external>
                    Get directions
                </Button>
            </div>
        </div>
    </section>

    <!-- Barbers: a white section, matching the white-backdrop portraits. -->
    <section
        aria-labelledby="barbers-heading"
        class="on-light bg-paper text-text-dark"
    >
        <div class="mx-auto max-w-page px-gutter py-section">
            <div class="max-w-prose">
                <h2 id="barbers-heading" class="text-4xl">
                    Meet the barbers
                </h2>
                <p class="mt-4 text-lg text-muted-dark">
                    {business.experienceLine} Book with the barber you
                    know, or try someone new.
                </p>
            </div>
            <ul
                class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6
                    lg:grid-cols-5"
                role="list"
            >
                {
                    barbers.map((barber) => (
                        <li class="flex">
                            <BarberCard barber={barber} headingLevel="h3" />
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- Services -->
    <section
        aria-labelledby="services-heading"
        class="mx-auto max-w-page px-gutter pt-section"
    >
        <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="services-heading" class="text-4xl text-text">
                Services
            </h2>
            <a
                href="/services/"
                class="py-2 text-sm uppercase text-gold
                    tracking-[var(--tracking-caps)] hover:underline"
            >
                All services
            </a>
        </div>
        <div class="mt-10">
            <ServiceList headingLevel="h3" />
        </div>
    </section>

    <!-- Reviews: real ones only; otherwise point to Google. -->
    <section
        aria-labelledby="reviews-heading"
        class="mx-auto max-w-page px-gutter pt-section"
    >
        <h2 id="reviews-heading" class="text-4xl text-text">
            What clients say
        </h2>
        {
            approvedReviews.length > 0 ? (
                <ul class="mt-10 grid gap-10 md:grid-cols-3" role="list">
                    {approvedReviews.slice(0, 3).map((review) => (
                        <li>
                            <figure class="border-l border-gold pl-6">
                                <blockquote class="text-lg text-text">
                                    “{review.quote}”
                                </blockquote>
                                <figcaption class="mt-4 text-sm text-muted">
                                    {review.author}, on {review.source}
                                </figcaption>
                            </figure>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="mt-4 max-w-prose text-lg text-muted">
                    See what clients say about us on Google, and leave a
                    review after your next visit.
                </p>
            )
        }
        <div class="mt-8">
            <Button href={reviewsUrl} variant="secondary" external>
                Read our Google reviews
            </Button>
        </div>
    </section>

    <BookingBand />
</BaseLayout>

<script>
    // Play the hero video only for visitors who haven't asked for
    // reduced motion; everyone else keeps the still photo.
    const video = document.querySelector<HTMLVideoElement>(".hero-video");
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (video && !calm.matches) {
        video.classList.remove("hidden");
        video.play().catch(() => video.classList.add("hidden"));
    }
</script>
