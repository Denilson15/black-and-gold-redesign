---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingBand from "../components/BookingBand.astro";
import PageHeader from "../components/PageHeader.astro";
import { business, faq } from "../content/site";

/*
 * Only confirmed answers are shown and marked up; unanswered questions
 * stay in the content file until the owner answers them. (Google no
 * longer shows FAQ rich results for most businesses, but the markup
 * still describes the page accurately.)
 */
const answered = faq.filter(
    (item): item is { question: string; answer: string } =>
        item.answer !== null,
);
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: answered.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
};
---

<BaseLayout
    title="FAQ: Walk-ins, Kids’ Cuts, Payment | Black & Gold East Bay"
    description="Answers about walk-ins, kids’ haircuts, payment,
        cancellations and parking at Black & Gold East Bay barbershop in
        Hayward, CA."
    breadcrumbs={[{ name: "FAQ", path: "/faq/" }]}
    schema={answered.length > 0 ? [faqSchema] : []}
>
    <PageHeader title="Frequently asked questions" />

    <div class="mx-auto mt-12 max-w-page px-gutter">
        <div class="max-w-prose border-t border-line">
            {
                answered.map((item) => (
                    <details class="group border-b border-line">
                        <summary
                            class="flex min-h-14 cursor-pointer list-none
                                items-center justify-between gap-4 py-4
                                text-lg text-text hover:text-gold
                                [&::-webkit-details-marker]:hidden"
                        >
                            <span>{item.question}</span>
                            <span
                                aria-hidden="true"
                                class="text-2xl font-light text-gold
                                    transition-transform
                                    group-open:rotate-45"
                            >
                                +
                            </span>
                        </summary>
                        <p class="pb-6 text-lg text-muted">{item.answer}</p>
                    </details>
                ))
            }
        </div>
        <p class="mt-8 max-w-prose text-lg text-muted">
            Have another question? Call{" "}
            <a
                href={`tel:${business.phoneE164}`}
                class="whitespace-nowrap text-text underline
                    hover:text-gold"
            >
                {business.phoneDisplay}
            </a>
            .
        </p>
    </div>

    <BookingBand heading="Still have a question?" />
</BaseLayout>
