---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingBand from "../components/BookingBand.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import { business, gallery } from "../content/site";

const instagramUrl = `https://www.instagram.com/${business.instagram.handle}/`;
---

<BaseLayout
    title="Haircut Gallery: Fades & Beards in Hayward | Black & Gold"
    description="Recent fades, tapers and beard work from the barbers at
        Black & Gold East Bay in Hayward, CA."
    breadcrumbs={[{ name: "Gallery", path: "/gallery/" }]}
>
    <PageHeader
        title="Recent cuts"
        intro="Fades, tapers and beard work from our chairs on B Street."
    />

    <div class="mx-auto mt-12 max-w-page px-gutter">
        {
            gallery.length > 0 && (
                <ul
                    class="grid grid-cols-2 gap-2 sm:gap-3 md:grid-cols-3"
                    role="list"
                >
                    {gallery.map((photo) => (
                        <li>
                            <Image
                                src={photo.src}
                                alt={photo.alt}
                                widths={[320, 480, 720]}
                                sizes="(min-width: 48rem) 33vw, 50vw"
                                class="aspect-square w-full object-cover"
                            />
                        </li>
                    ))}
                </ul>
            )
        }
        <p class="mt-8 max-w-prose text-lg text-muted">
            See our latest work on Instagram.
        </p>
        <div class="mt-5">
            <Button href={instagramUrl} variant="secondary" external>
                @{business.instagram.handle} on Instagram
            </Button>
        </div>
    </div>

    <BookingBand />
</BaseLayout>
