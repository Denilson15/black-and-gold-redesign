---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookingBand from "../components/BookingBand.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import { business, gallery } from "../content/site";

const instagramUrl = `https://www.instagram.com/${business.instagram.handle}/`;
// Empty slots shown until the owner approves real photos.
const placeholderSlots = 6;
---

<BaseLayout
    title="Haircut Gallery: Fades & Beards in Hayward | Black & Gold"
    description="Recent fades, tapers and beard work from the barbers at
        Black & Gold East Bay in Hayward, CA."
    breadcrumbs={[{ name: "Gallery", path: "/gallery/" }]}
>
    <PageHeader
        title="Recent cuts"
        intro="Fades, tapers and beard work from our chairs on B Street."
    />

    <div class="mx-auto mt-10 max-w-page px-gutter">
        {
            gallery.length > 0 ? (
                <ul
                    class="grid grid-cols-2 gap-3 md:grid-cols-3"
                    role="list"
                >
                    {gallery.map((photo) => (
                        <li>
                            <img
                                src={photo.src}
                                alt={photo.alt}
                                width={photo.width}
                                height={photo.height}
                                loading="lazy"
                                decoding="async"
                                class="aspect-square w-full rounded-panel
                                    object-cover"
                            />
                        </li>
                    ))}
                </ul>
            ) : (
                <>
                    <ul
                        class="grid grid-cols-2 gap-3 md:grid-cols-3"
                        aria-label="Photo slots awaiting the shop’s photos"
                    >
                        {Array.from({ length: placeholderSlots }, () => (
                            <li
                                class="flex aspect-square items-center
                                    justify-center rounded-panel border
                                    border-dashed border-line-strong
                                    p-4 text-center text-sm text-muted"
                            >
                                Photo coming soon
                            </li>
                        ))}
                    </ul>
                    <p class="mt-6 max-w-prose text-lg text-muted">
                        Our latest work is on Instagram while we put this
                        gallery together.
                    </p>
                    <div class="mt-4">
                        <Button
                            href={instagramUrl}
                            variant="secondary"
                            external
                        >
                            See recent cuts on Instagram
                        </Button>
                    </div>
                </>
            )
        }
    </div>

    <BookingBand />
</BaseLayout>
