---
import BaseLayout from "../layouts/BaseLayout.astro";
import BarberCard from "../components/BarberCard.astro";
import BookingBand from "../components/BookingBand.astro";
import { barbers, business } from "../content/site";
import { firstName } from "../lib/format";

// Built from the barber list so it never goes stale.
const names = barbers.map((b) => firstName(b.name));
const nameList =
    names.length > 1
        ? `${names.slice(0, -1).join(", ")} or ${names.at(-1)}`
        : names.join("");
---

<BaseLayout
    title="Barbers in Hayward, CA | Black & Gold East Bay"
    description={`Meet the barbers at Black & Gold East Bay in Hayward ` +
        `and book directly with ${nameList}.`}
    breadcrumbs={[{ name: "Barbers", path: "/barbers/" }]}
>
    <section class="on-light bg-paper text-text-dark">
        <div class="mx-auto max-w-page px-gutter py-14 sm:py-20">
            <div class="h-px w-12 bg-text-dark" aria-hidden="true"></div>
            <h1 class="mt-6 text-4xl">Meet the barbers</h1>
            <p class="mt-5 max-w-prose text-lg text-muted-dark">
                {business.experienceLine} Tap “Book with” to see a
                barber’s open times and pick a slot.
            </p>
            <ul
                class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6
                    lg:grid-cols-3"
                role="list"
            >
                {
                    barbers.map((barber) => (
                        <li class="flex">
                            <BarberCard barber={barber} />
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <BookingBand heading="Not sure who to pick?" flush />
</BaseLayout>
