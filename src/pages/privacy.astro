---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { business } from "../content/site";
---

<BaseLayout
    title="Privacy | Black & Gold East Bay"
    description="How the Black & Gold East Bay website handles your
        information: it collects none. Booking happens on Blismo and
        messages on Instagram."
    breadcrumbs={[{ name: "Privacy", path: "/privacy/" }]}
>
    <PageHeader title="Privacy" />

    <div class="mx-auto mt-8 max-w-page px-gutter pb-section">
        <div class="max-w-prose space-y-5 text-lg text-muted">
            <p>
                This website doesn’t collect personal information. It
                has no forms, no accounts and no tracking or advertising
                cookies.
            </p>
            <h2 class="pt-4 text-xl text-text">Booking and messages</h2>
            <p>
                When you tap “Book now”, you go to Blismo, our booking
                service. When you tap “Message on Instagram”, you go to
                Instagram. Anything you enter there is handled under
                Blismo’s and Instagram’s own privacy policies.
            </p>
            <h2 class="pt-4 text-xl text-text">Maps</h2>
            <p>
                The map on our Location page is provided by Google. It
                loads only if you tap “Show map”, and Google’s privacy
                policy applies once it does.
            </p>
            <h2 class="pt-4 text-xl text-text">Hosting</h2>
            <p>
                Like any website host, our host may keep standard server
                logs (such as IP address and browser type) to keep the
                site secure and running.
            </p>
            <h2 class="pt-4 text-xl text-text">Questions</h2>
            <p>
                Call us at{" "}
                <a
                    href={`tel:${business.phoneE164}`}
                    class="text-text underline hover:text-gold"
                >
                    {business.phoneDisplay}
                </a>
                .
            </p>
        </div>
    </div>
</BaseLayout>
